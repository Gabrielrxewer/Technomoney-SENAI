# Runtime basics
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
ENTRY_FILE=dist/server.js
SWAGGER_FILE=dist/openapi.yaml
SWAGGER_ENABLED=false
SWAGGER_BASIC_USER=
SWAGGER_BASIC_PASS=

# Observability
LOG_LEVEL=info
HTTP_SUCCESS_LOG_LEVEL=info
AUTH_VERBOSE_ERRORS=0

# Front-end / CORS
FE_URL=https://app.example.com
ALLOWED_ORIGINS=https://app.example.com
AUTH_BASE_URL=https://auth.example.com
COOKIE_DOMAIN=
COOKIE_SECURE=true

# Database (principle of least privilege + TLS em produção)
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=technomoney_auth
DB_HOST=postgres
DB_PORT=5432
DB_DRIVER=postgres
SEQUELIZE_DIR_HINT=/app/dist

# Redis & trusted devices
REDIS_URL=redis://redis:6379/0
REDIS_CONNECT_TIMEOUT_MS=15000
REDIS_RECONNECT_BASE_MS=500
REDIS_RECONNECT_MAX_MS=2000
REDIS_INIT_GRACE_MS=5000
TRUSTED_DEVICE_SECRET=

# MFA / password hygiene
TOTP_ENC_KEY=
TOTP_ISSUER=Technomoney
TOTP_REPLAY_TTL=300
TOTP_LIMIT_POINTS=5
TOTP_LIMIT_WINDOW_SEC=300
PWNED_CHECK=true
AUTH_REQUIRE_VERIFIED_EMAIL=false
AUTH_CONTROLLER_SKIP_DEFAULT=0

# reCAPTCHA v3 (habilitar em produção)
RECAPTCHA_SECRET=
RECAPTCHA_HOSTNAME=app.example.com
RECAPTCHA_EXPECTED_ACTION=login
RECAPTCHA_MIN_SCORE=0.7

# OAuth2 / OpenID Connect
OIDC_CLIENTS=
REQUIRE_PAR=false
REQUIRE_DPOP=false
INTROSPECTION_CLIENTS=
INTROSPECTION_MTLS_ALLOWED_CNS=

# JWT signing (carregue chaves geradas externamente em produção)
JWT_ALG=ES256
JWT_ALLOWED_ALGS=ES256
JWT_ALLOWED_ALGS_SIGN=ES256
JWT_ALLOWED_ALGS_VERIFY=ES256
JWT_ISSUER=technomoney-auth
JWT_AUDIENCE=technomoney-web
JWT_EXPIRES_IN=300
JWT_REFRESH_EXPIRES_IN=28800
JWT_CLOCK_TOLERANCE=5
JWT_KID=jwt-ES256-2025-09
JWT_KEYS_DIR=/app/keys
# Somente habilite JWT_AUTO_GENERATE_KEYS fora de produção para gerar pares efêmeros
JWT_AUTO_GENERATE_KEYS=0
JWT_KEYS_ROTATION_TAGS=2025-09,2026-03
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Recovery flows
PASSWORD_RESET_URL=https://app.example.com/reset-password
EMAIL_VERIFICATION_URL=https://app.example.com/verify-email
RESET_TOKEN_TTL=1800
EMAIL_VERIFICATION_TOKEN_TTL=1200

